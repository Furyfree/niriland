#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=scripts/lib/common
source "$REPO_ROOT/scripts/lib/common"
# shellcheck source=scripts/lib/config
source "$REPO_ROOT/scripts/lib/config"
# shellcheck source=scripts/lib/migrations
source "$REPO_ROOT/scripts/lib/migrations"
# shellcheck source=scripts/lib/plan
source "$REPO_ROOT/scripts/lib/plan"

usage() {
  cat <<'EOF'
Usage: niriland <command> [options]

Phase 1 commands:
  plan [--prune]  Validate the selected profile and show read-only foundations
  status          Show the selected profile and migration foundation status
  help            Show this help

Reserved commands (implemented in later phases):
  apply [--prune]
  update
  postinstall <action>

Set NIRILAND_MACHINE_CONFIG to test another machine configuration. The default
is machine.local.conf in the repository root.
EOF
}

resolve_machine() {
  local config_file="${NIRILAND_MACHINE_CONFIG:-$REPO_ROOT/machine.local.conf}"

  niriland_resolve_machine "$REPO_ROOT" "$config_file"
}

emit_migration_plan() {
  local state_root="$1"
  local index
  local migration_id
  local migration_file

  niriland_discover_migrations "$REPO_ROOT/migrations"
  for index in "${!NIRILAND_MIGRATION_IDS[@]}"; do
    migration_id="${NIRILAND_MIGRATION_IDS[$index]}"
    migration_file="${NIRILAND_MIGRATION_FILES[$index]}"
    niriland_migration_receipt_status \
      "$migration_id" "$migration_file" "$state_root"
    case "$NIRILAND_MIGRATION_STATUS" in
      complete)
        niriland_plan_emit NOOP "migration:$migration_id" "$NIRILAND_MIGRATION_DETAIL"
        ;;
      pending)
        niriland_plan_emit MIGRATE "migration:$migration_id" "$NIRILAND_MIGRATION_DETAIL"
        ;;
      legacy)
        niriland_plan_emit DEFER "migration:$migration_id" "$NIRILAND_MIGRATION_DETAIL"
        ;;
      changed|invalid)
        niriland_plan_emit BLOCKED "migration:$migration_id" "$NIRILAND_MIGRATION_DETAIL"
        ;;
      *)
        niriland_die "Unknown migration status: $NIRILAND_MIGRATION_STATUS"
        ;;
    esac
  done
}

run_plan() {
  local prune=false
  local package_set
  local state_root

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prune)
        prune=true
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        niriland_die "Unknown plan option: $1" || return 1
        ;;
    esac
    shift
  done

  resolve_machine
  state_root="$(niriland_state_root)"
  niriland_plan_reset

  printf 'Niriland plan\n'
  printf 'Profile: %s\n' "$NIRILAND_PROFILE"
  printf 'Prune: %s\n\n' "$prune"
  niriland_plan_emit SELECT "profile:$NIRILAND_PROFILE" "selected by machine config"
  for package_set in "${NIRILAND_PACKAGE_SETS[@]}"; do
    niriland_plan_emit DEFER "package-set:$package_set" "package reconciliation begins in Phase 2"
  done
  emit_migration_plan "$state_root"
  if [[ "$prune" == "true" ]]; then
    niriland_plan_emit DEFER "package-prune:untracked" "removal analysis begins in Phase 2"
  fi
  niriland_plan_summary
  printf 'No files, packages, services, or state were changed.\n'
}

run_status() {
  local state_root
  local package_sets

  resolve_machine
  state_root="$(niriland_state_root)"
  package_sets="$(IFS=,; printf '%s' "${NIRILAND_PACKAGE_SETS[*]}")"
  niriland_discover_migrations "$REPO_ROOT/migrations"

  printf 'Profile: %s\n' "$NIRILAND_PROFILE"
  printf 'Profile file: %s\n' "$NIRILAND_PROFILE_FILE"
  printf 'Package sets: %s\n' "$package_sets"
  printf 'State root: %s%s\n' "$state_root" \
    "$([[ -d "$state_root" ]] && printf ' (present)' || printf ' (not created)')"
  printf 'Discovered migrations: %d\n' "${#NIRILAND_MIGRATION_IDS[@]}"
}

reserved_command() {
  niriland_error "$1 is reserved for a later phase and made no changes."
  return 2
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift

  case "$command" in
    plan)
      run_plan "$@"
      ;;
    status)
      [[ $# -eq 0 ]] || niriland_die "status does not accept arguments"
      run_status
      ;;
    apply|update|postinstall)
      reserved_command "$command"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      niriland_die "Unknown command: $command"
      ;;
  esac
}

main "$@"
