#!/usr/bin/env bash

# shellcheck source=scripts/lib/common
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common"

declare -g NIRILAND_PROFILE=""
declare -g NIRILAND_PROFILE_FILE=""
declare -ga NIRILAND_PACKAGE_SETS=()

niriland_parse_machine_config() {
  local config_file="$1"
  local line
  local key
  local value
  local line_number=0

  [[ -f "$config_file" ]] \
    || niriland_die "Machine config not found: $config_file" \
    || return 1

  NIRILAND_PROFILE=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    line="$(niriland_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue

    if [[ "$line" != *=* ]]; then
      niriland_die "$config_file:$line_number: expected key=value" || return 1
    fi

    key="$(niriland_trim "${line%%=*}")"
    value="$(niriland_trim "${line#*=}")"

    case "$key" in
      profile)
        if [[ -n "$NIRILAND_PROFILE" ]]; then
          niriland_die "$config_file:$line_number: duplicate profile" || return 1
        fi
        niriland_validate_identifier "$value" \
          || niriland_die "$config_file:$line_number: invalid profile: $value" \
          || return 1
        NIRILAND_PROFILE="$value"
        ;;
      *)
        niriland_die "$config_file:$line_number: unknown key: $key" || return 1
        ;;
    esac
  done <"$config_file"

  [[ -n "$NIRILAND_PROFILE" ]] \
    || niriland_die "$config_file: missing required profile" \
    || return 1
}

niriland_parse_profile() {
  local repo_root="$1"
  local profile="$2"
  local line
  local key
  local value
  local package_set
  local line_number=0
  local have_package_sets=false
  local -a parsed_sets=()
  local -A seen_sets=()

  niriland_validate_identifier "$profile" \
    || niriland_die "Invalid profile identifier: $profile" \
    || return 1

  NIRILAND_PROFILE_FILE="$repo_root/profiles/$profile.conf"
  [[ -f "$NIRILAND_PROFILE_FILE" ]] \
    || niriland_die "Profile not found: $NIRILAND_PROFILE_FILE" \
    || return 1

  NIRILAND_PACKAGE_SETS=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    line="$(niriland_trim "$line")"
    [[ -z "$line" || "$line" == \#* ]] && continue

    if [[ "$line" != *=* ]]; then
      niriland_die "$NIRILAND_PROFILE_FILE:$line_number: expected key=value" \
        || return 1
    fi

    key="$(niriland_trim "${line%%=*}")"
    value="$(niriland_trim "${line#*=}")"

    case "$key" in
      package_sets)
        if [[ "$have_package_sets" == "true" ]]; then
          niriland_die "$NIRILAND_PROFILE_FILE:$line_number: duplicate package_sets" \
            || return 1
        fi
        have_package_sets=true
        IFS=',' read -r -a parsed_sets <<<"$value"
        [[ ${#parsed_sets[@]} -gt 0 ]] \
          || niriland_die "$NIRILAND_PROFILE_FILE:$line_number: package_sets is empty" \
          || return 1

        for package_set in "${parsed_sets[@]}"; do
          package_set="$(niriland_trim "$package_set")"
          niriland_validate_identifier "$package_set" \
            || niriland_die "$NIRILAND_PROFILE_FILE:$line_number: invalid package set: $package_set" \
            || return 1
          if [[ -n "${seen_sets[$package_set]:-}" ]]; then
            niriland_die "$NIRILAND_PROFILE_FILE:$line_number: duplicate package set: $package_set" \
              || return 1
          fi
          [[ -f "$repo_root/packages/$package_set.packages" ]] \
            || niriland_die "Missing package manifest: $repo_root/packages/$package_set.packages" \
            || return 1
          seen_sets[$package_set]=1
          NIRILAND_PACKAGE_SETS+=("$package_set")
        done
        ;;
      *)
        niriland_die "$NIRILAND_PROFILE_FILE:$line_number: unknown key: $key" \
          || return 1
        ;;
    esac
  done <"$NIRILAND_PROFILE_FILE"

  [[ "$have_package_sets" == "true" ]] \
    || niriland_die "$NIRILAND_PROFILE_FILE: missing required package_sets" \
    || return 1
}

niriland_resolve_machine() {
  local repo_root="$1"
  local config_file="$2"

  niriland_parse_machine_config "$config_file" || return 1
  niriland_parse_profile "$repo_root" "$NIRILAND_PROFILE"
}
