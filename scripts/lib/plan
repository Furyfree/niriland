#!/usr/bin/env bash

# shellcheck source=scripts/lib/common
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common"

declare -g NIRILAND_PLAN_SELECTED=0
declare -g NIRILAND_PLAN_DEFERRED=0
declare -g NIRILAND_PLAN_PENDING=0
declare -g NIRILAND_PLAN_BLOCKED=0
declare -g NIRILAND_PLAN_REMOVALS=0

niriland_plan_reset() {
  NIRILAND_PLAN_SELECTED=0
  NIRILAND_PLAN_DEFERRED=0
  NIRILAND_PLAN_PENDING=0
  NIRILAND_PLAN_BLOCKED=0
  NIRILAND_PLAN_REMOVALS=0
}

niriland_validate_resource_id() {
  [[ "$1" =~ ^[a-z][a-z0-9-]*:([A-Za-z0-9]|\.[A-Za-z0-9])[A-Za-z0-9._/-]*$ ]]
}

niriland_plan_emit() {
  local action="$1"
  local resource_id="$2"
  local detail="$3"

  niriland_validate_resource_id "$resource_id" \
    || niriland_die "Invalid resource ID: $resource_id" \
    || return 1
  [[ "$detail" != *$'\n'* && "$detail" != *$'\t'* ]] \
    || niriland_die "Plan detail must be a single field" \
    || return 1

  case "$action" in
    SELECT)
      NIRILAND_PLAN_SELECTED=$((NIRILAND_PLAN_SELECTED + 1))
      ;;
    DEFER)
      NIRILAND_PLAN_DEFERRED=$((NIRILAND_PLAN_DEFERRED + 1))
      ;;
    MIGRATE)
      NIRILAND_PLAN_PENDING=$((NIRILAND_PLAN_PENDING + 1))
      ;;
    BLOCKED)
      NIRILAND_PLAN_BLOCKED=$((NIRILAND_PLAN_BLOCKED + 1))
      ;;
    REMOVE)
      NIRILAND_PLAN_REMOVALS=$((NIRILAND_PLAN_REMOVALS + 1))
      ;;
    NOOP|CREATE|UPDATE)
      ;;
    *)
      niriland_die "Unknown plan action: $action" || return 1
      ;;
  esac

  printf '  %-8s %-36s %s\n' "$action" "$resource_id" "$detail"
}

niriland_plan_summary() {
  printf '\nPlan: %d selected, %d deferred, %d migrations pending, %d blocked, %d removals.\n' \
    "$NIRILAND_PLAN_SELECTED" \
    "$NIRILAND_PLAN_DEFERRED" \
    "$NIRILAND_PLAN_PENDING" \
    "$NIRILAND_PLAN_BLOCKED" \
    "$NIRILAND_PLAN_REMOVALS"
}
