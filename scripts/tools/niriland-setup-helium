#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: niriland-setup-helium"
}

command -v pacman >/dev/null 2>&1 || { echo "Missing required command: pacman" >&2; exit 1; }
command -v sudo >/dev/null 2>&1 || { echo "Missing required command: sudo" >&2; exit 1; }

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ $# -gt 0 ]]; then
  usage >&2
  exit 1
fi

sudo -v || { echo "sudo authentication failed" >&2; exit 1; }

echo "Installing Helium and Widevine..."
sudo pacman -S --needed --noconfirm helium-browser-bin chromium-widevine

widevine_dir="/usr/lib/chromium/WidevineCdm"
helium_dir="/opt/helium-browser-bin"

if [[ ! -d "$widevine_dir" ]]; then
  echo "Widevine directory not found after installation: $widevine_dir" >&2
  exit 1
fi

if [[ ! -d "$helium_dir" ]]; then
  echo "Helium directory not found after installation: $helium_dir" >&2
  exit 1
fi

echo "Linking Widevine into Helium..."
sudo ln -sfnT "$widevine_dir" "$helium_dir/WidevineCdm"

echo "Allowing Helium to integrate with 1Password..."
allowed_browsers="/etc/1password/custom_allowed_browsers"
sudo mkdir -p /etc/1password
sudo touch "$allowed_browsers"

if ! sudo grep -qxF "helium" "$allowed_browsers"; then
  printf "helium\n" | sudo tee -a "$allowed_browsers" >/dev/null
fi

sudo chown root:root "$allowed_browsers"
sudo chmod 755 "$allowed_browsers"

echo "Helium setup complete. Restart Helium and 1Password if they are running."
